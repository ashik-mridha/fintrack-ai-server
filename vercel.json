{
    "version": 2,
    "cleanUrls": true,
    "trailingSlash": false,
    "publicLogs": true,
    "framework": "nextjs",
    "buildCommand": "npm run build",
    "outputDirectory": ".next",
    "headers": [
        {
            "source": "/service-worker.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/old-blog/:path*",
            "destination": "/blog/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/api/v1/:path*",
            "destination": "https://example.com*"
        }
    ],
    "functions": {
        "api/heavy-task.js": {
            "runtime": "nodejs18.x",
            "maxDuration": 60,
            "memory": 1024,
            "regions": [
                "iad1"
            ]
        }
    },
    "crons": [
        {
            "path": "/api/cron/cleanup",
            "schedule": "0 0 * * *"
        }
    ]
}